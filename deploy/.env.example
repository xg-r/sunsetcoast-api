# 운영 .env에 들어갈 항목. 서버에서는 직접 만들지 않고 fetch-env.sh가 Parameter Store(/sunsetcoast/prod/<이름>)에서 만든다.
# 비밀번호는 길고 무작위로: openssl rand -base64 24 (작은따옴표 ' 는 쓰지 않는다)
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=

NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
# 첫 슈퍼어드민: 플랫폼:이메일 또는 플랫폼:계정번호, 쉼표로 여러 개
AUTH_SUPER_ADMINS=

# Let's Encrypt 인증서 만료 안내를 받을 이메일
ACME_EMAIL=

# 이미지 태그 (기본 latest). 문제가 생기면 이전 커밋 태그(sha-xxxxxxx)로 되돌린다
API_TAG=latest
WEB_TAG=latest

# 백업 (deploy/backup.sh): S3 버킷과 경로
BACKUP_S3_URI=s3://<버킷 이름>/sunsetcoast-db
