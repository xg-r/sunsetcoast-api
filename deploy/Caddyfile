# HTTPS 인증서는 Caddy가 Let's Encrypt에서 자동으로 받고 갱신한다 (DNS A 레코드가 이 서버를 가리켜야 함)
{
	email {$ACME_EMAIL:admin@sunsetcoast.kr}
}

(security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
		X-Robots-Tag "noindex, nofollow"
		-Server
	}
}

# 관리자 화면. 브라우저는 여기만 쓰고, 화면 서버가 /api/* 를 내부망의 api로 넘긴다
admin.sunsetcoast.kr {
	import security_headers
	encode zstd gzip
	reverse_proxy web:3000
}

# 일반 사용자용 API (sunsetcoast.kr). 공개 경로만 연다. 관리자 API는 여기서 닿지 않는다
api.sunsetcoast.kr {
	import security_headers
	encode zstd gzip
	@user path /public/* /me/*
	handle @user {
		reverse_proxy api:8080
	}
	handle {
		respond "Not Found" 404
	}
}
